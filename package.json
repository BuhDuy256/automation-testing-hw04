{
  "name": "eshop-hw06-api-testing",
  "private": true,
  "version": "1.0.0",
  "description": "Evidence-first automation harness for HW06 API Testing",
  "scripts": {
    "hw06:validate": "node scripts/hw06/validate.mjs",
    "hw06:validate:submission": "node scripts/hw06/validate.mjs --submission",
    "hw06:derive": "node scripts/hw06/derive.mjs",
    "hw06:git-log": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hw06/export-git-log.ps1",
    "hw06:curate-out": "node scripts/hw06/curate-out.mjs",
    "hw06:export-xlsx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hw06/export-test-cases.ps1",
    "hw06:render-pdf": "node scripts/hw06/render-markdown-pdf.mjs",
    "hw06:validate:out": "node scripts/hw06/validate-out.mjs",
    "hw06:finalize": "npm run hw06:derive && npm run hw06:curate-out && npm run hw06:render-pdf && npm run hw06:validate && npm run hw06:validate:out"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "playwright-core": "^1.62.1",
    "yaml": "^2.8.1"
  }
}

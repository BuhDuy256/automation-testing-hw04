{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is required because addInitScript / page.evaluate callbacks are typechecked as
    // browser code (they reference window, localStorage, document).
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"]
  }
}
